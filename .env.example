# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local. These two values are safe for the browser:
# the anon key is public by design and is governed by Row Level Security.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-side only (set in Netlify environment, NOT prefixed with VITE_) ---
# These must never reach the browser. Used only by Netlify functions in later phases.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# RESEND_API_KEY=your-resend-api-key
